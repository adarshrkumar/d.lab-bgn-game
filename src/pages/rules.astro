---
import '../styles/rules.scss'
import Layout from '../layouts/Layout.astro'

const modules = import.meta.glob('../../rules/*.md', { eager: true })

const sections = Object.entries(modules).sort(([a], [b]) => {
    const na = parseInt(a.split('/').pop() ?? '', 10)
    const nb = parseInt(b.split('/').pop() ?? '', 10)
    return na - nb
})
---
<Layout title="Rules">
    <article class="items">
        {sections.map(([, mod]) =>
            <section class="item" set:html={mod.compiledContent()} />
        )}
    </article>
</Layout>

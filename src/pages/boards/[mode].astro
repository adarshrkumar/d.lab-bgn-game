---
export function getStaticPaths() {
    return [
        {params: {mode: 'learner'}}, 
        {params: {mode: 'easy'}}, 
        {params: {mode: 'medium'}}, 
        {params: {mode: 'hard'}}, 
        {params: {mode: 'extreme'}}, 
    ]
}

function randomNum(max) {
    return Math.floor(Math.random() * max) + 1;
}

var allBoards = {
    learner: await Astro.glob('../../../boards/learner/*.json'),
    easy: await Astro.glob('../../../boards/easy/*.json'),
    medium: await Astro.glob('../../../boards/medium/*.json'),
    hard: await Astro.glob('../../../boards/hard/*.json'),
    extreme: await Astro.glob('../../../boards/extreme/*.json'),
}

const { mode } = Astro.params;
if (!mode) mode = 'default'

var boards = allBoards[mode]

var fName = mode === 'default' ? 0 : randomNum(boards.length)

var tiles = boards.filter(b => b.name === fName)
console.log(fName)

import Layout from '../../layouts/Layout.astro'
import '../../styles/board.scss'

var mTitle = `${mode.slice(0, 1).toUpperCase()}${mode.slice(1)}`
var pTitle = `${mTitle} | Board Configurations`
---
<Layout title={pTitle}>
    <main class="grid-parent">
        {
            tiles.map(t => {
                <section class="grid">
                    {}
                    {
                        t.tiles.map((row, i) => {
                            var amt = 4
                            if (i%2) amt++
                            return (
                                <div class="row">
                                    {row.map(tile => {
                                        return (<div class={`item ${tile}`} />)
                                    })}
                                </div>
                            )
                        })
                    }
                </section>
            })
        }
    </main>
    <script>
        javascript:(function () { var script = document.createElement('script'); script.src="//cdn.jsdelivr.net/npm/eruda"; document.body.appendChild(script); script.onload = function () { eruda.init() } })();
    </script>
</Layout>